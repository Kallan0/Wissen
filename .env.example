# Local inference (offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3
OLLAMA_ENABLED=true

# Cloud inference (optional). Keep the real key only in .env, never in Git.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b
GROQ_MODELS=openai/gpt-oss-20b

# ollama or groq. For cloud-only startup, set OLLAMA_ENABLED=false.
AI_DEFAULT_PROVIDER=ollama

# Retrieval pipeline. Logical resume sections are preserved; unstructured
# prose uses MiniLM semantic boundaries. Hybrid retrieval fuses HNSW ANN and BM25.
CHROMA_EMBEDDING_CACHE_DIR=backend/data/embedding_cache/onnx_models
SEMANTIC_CHUNK_MIN_WORDS=60
SEMANTIC_CHUNK_MAX_WORDS=220
SEMANTIC_CHUNK_BREAK_PERCENTILE=25
HYBRID_DENSE_WEIGHT=0.70
HYBRID_BM25_WEIGHT=0.30
HYBRID_MIN_SCORE=0.0
RAG_MAX_CONTEXT_CHARS=24000
AI_MAX_OUTPUT_TOKENS=6000
AI_PROVIDER_FAILURE_COOLDOWN_SECONDS=30
BACKEND_RELOAD=false
